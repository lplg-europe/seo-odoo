<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        SEO AUDIT REPORT - self-contained QWeb PDF (Odoo 19)
        Carries its own header/footer in the body (no web.external_layout):
        works out of the box on any database, even before the company
        configured its document layout.
    -->

    <!-- ============================ Paperformat ============================ -->
    <!-- Dedicated A4 format with balanced margins. base.paperformat_euro
         reserves 40 mm at the top for a page header this report doesn't use
         (hence a big empty top band) and only 7 mm left/right. -->
    <record id="paperformat_seo_site" model="report.paperformat">
        <field name="name">SEO Audit (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- ============================ Print action ============================ -->
    <!-- Overview: the state-of-play report used to win a prospect
         (Quick audit wizard prints this one). -->
    <record id="action_report_seo_site" model="ir.actions.report">
        <field name="name">SEO Audit (overview)</field>
        <field name="model">seo.site</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seo_suite.report_seo_site</field>
        <field name="report_file">seo_suite.report_seo_site</field>
        <field name="binding_model_id" ref="model_seo_site"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'SEO Audit - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_seo_site"/>
    </record>

    <!-- Complete: same report plus the solutions — how-to-fix
         recommendations, keyword opportunities, ready-to-apply AI metas.
         This is what a signed client receives (email reports use it). -->
    <record id="action_report_seo_site_full" model="ir.actions.report">
        <field name="name">SEO Audit (complete)</field>
        <field name="model">seo.site</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seo_suite.report_seo_site_full</field>
        <field name="report_file">seo_suite.report_seo_site_full</field>
        <field name="binding_model_id" ref="model_seo_site"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'SEO Audit complete - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_seo_site"/>
    </record>

    <!-- ============================ Wrappers ============================ -->
    <template id="report_seo_site">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="seo_suite.report_seo_site_document"/>
            </t>
        </t>
    </template>

    <template id="report_seo_site_full">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="seo_suite.report_seo_site_document">
                    <t t-set="full" t-value="True"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================ Document ============================ -->
    <template id="report_seo_site_document">
        <!-- Brand color follows the issuing company's document-layout color
             (Settings > Configure document layout > Colors), so every agency
             using this open-source module gets its own branding. -->
        <t t-set="brand" t-value="res_company.primary_color or '#31408F'"/>
        <t t-set="score_cls" t-value="'good' if doc.score &gt;= 80 else ('mid' if doc.score &gt;= 60 else 'bad')"/>
        <t t-set="score_label" t-value="'Good' if doc.score &gt;= 80 else ('Needs improvement' if doc.score &gt;= 60 else 'Poor')"/>

        <div class="article" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id">
            <style>
                .seo { color:#1F2933; font-size:9.5pt; line-height:1.4; }
                /* NO border-collapse:collapse anywhere - wkhtmltopdf paints
                   collapsed 0-width edges as hairlines on some hosts
                   (DPI-rounding dependent). `separate` + spacing 0 renders
                   the designed per-cell borders identically. */
                .seo table { border-collapse:separate !important; border-spacing:0 !important; border:0 !important; border-color:transparent; }
                .seo td, .seo th { border:0 !important; border-color:transparent; }
                .seo .est-name { font-size:12pt; font-weight:bold; }
                .seo .est-sub { font-size:8.5pt; color:#6B7280; }
                .seo .title { font-size:20pt; font-weight:bold; color:<t t-out="brand"/>; text-align:right; letter-spacing:.5px; }
                .seo .title-meta { font-size:9pt; color:#6B7280; text-align:right; margin-top:2px; }
                .seo .title-meta b { color:#1F2933; }
                .seo .type-badge { display:inline-block; padding:3px 12px; border-radius:12px; font-size:9pt; font-weight:bold; letter-spacing:.5px; text-transform:uppercase; }
                .seo .type-good { background:#E1F5EE; color:#0F6E56; }
                .seo .type-mid { background:#FAEEDA; color:#854F0B; }
                .seo .type-bad { background:#FCEBEB; color:#A32D2D; }
                .seo .rule { border-bottom:2px solid <t t-out="brand"/>; margin:10px 0 14px; }
                .seo .section { font-size:11pt; font-weight:bold; color:<t t-out="brand"/>; margin:18px 0 7px; border-bottom:1px solid #D7DEDC; padding-bottom:3px; page-break-after:avoid; }
                .seo .score-box { width:96px; height:96px; border-radius:10px; color:#FFF; text-align:center; }
                .seo .score-good { background:#0F6E56; }
                .seo .score-mid { background:#B45309; }
                .seo .score-bad { background:#A32D2D; }
                .seo .score-num { font-size:30pt; font-weight:bold; padding-top:16px; line-height:1; }
                .seo .score-of { font-size:8pt; padding-top:3px; opacity:.85; }
                .seo .score-word-good { color:#0F6E56; font-size:13pt; font-weight:bold; }
                .seo .score-word-mid { color:#B45309; font-size:13pt; font-weight:bold; }
                .seo .score-word-bad { color:#A32D2D; font-size:13pt; font-weight:bold; }
                .seo .trend-up { color:#0F6E56; font-weight:bold; }
                .seo .trend-down { color:#A32D2D; font-weight:bold; }
                .seo .muted { color:#6B7280; }
                .seo table.hbars { width:100%; margin-top:8px; font-size:8.5pt; }
                .seo table.hbars td { padding:2px 0; vertical-align:middle; }
                .seo td.hlabel { width:96px; color:#6B7280; padding-right:8px; }
                .seo td.hpct { width:34px; text-align:right; font-weight:bold; padding-left:7px; }
                .seo .hbar { background:#E5E7EB; border-radius:4px; height:7px; }
                .seo .hfill { border-radius:4px; height:7px; }
                .seo .bg-good { background:#0F6E56; }
                .seo .bg-mid { background:#B45309; }
                .seo .bg-bad { background:#A32D2D; }
                .seo table.kpis { width:100%; border-spacing:8px 0 !important; margin:12px 0 2px; }
                .seo td.kpi { width:25%; border:1px solid #E3E6E5 !important; border-radius:5px; background:#FBFCFB; padding:8px 12px; }
                .seo .kpi-v { font-size:15pt; font-weight:bold; }
                .seo .kpi-v .crit-note { font-size:8pt; color:#A32D2D; }
                .seo .kpi-l { font-size:7.5pt; text-transform:uppercase; letter-spacing:.4px; color:#6B7280; margin-top:1px; }
                .seo .kpi-bad { color:#A32D2D; }
                .seo table.lines { width:100%; border:1px solid #C3CDCA !important; }
                .seo table.lines thead th { background:<t t-out="brand"/>; color:#FFF; font-size:8pt; font-weight:bold; text-align:left; padding:6px 8px; text-transform:uppercase; letter-spacing:.3px; border-right:1px solid rgba(255,255,255,.22) !important; }
                .seo table.lines thead th.num { text-align:right; }
                .seo table.lines tbody td { border-bottom:1px solid #E5E7EB !important; border-right:1px solid #ECEEED !important; padding:5px 8px; vertical-align:top; font-size:9pt; }
                .seo table.lines thead th:last-child, .seo table.lines tbody td:last-child { border-right:0 !important; }
                .seo table.lines tbody tr:last-child td { border-bottom:0 !important; }
                .seo table.lines tbody tr:nth-child(even) td { background:#FAFAF7; }
                .seo table.lines td.num { text-align:right; }
                .seo table.lines td.center { text-align:center; }
                .seo table.lines td.path { font-family:monospace; font-size:8pt; word-break:break-all; }
                .seo table.lines td.zero { color:#9C9A92; }
                .seo .pill { display:inline-block; padding:1px 8px; border-radius:10px; font-size:7.5pt; font-weight:bold; letter-spacing:.3px; text-transform:uppercase; }
                .seo .pill-crit { background:#FCEBEB; color:#A32D2D; }
                .seo .pill-warn { background:#FAEEDA; color:#854F0B; }
                .seo .pill-info { background:#E3EEFA; color:#1D5CA3; }
                .seo .score-pill { display:inline-block; min-width:24px; padding:1px 6px; border-radius:9px; font-weight:bold; color:#FFF; text-align:center; font-size:8.5pt; }
                .seo .dot { display:inline-block; width:6px; height:6px; border-radius:3px; margin-right:5px; }
                .seo .dot-crit { background:#A32D2D; }
                .seo .dot-warn { background:#D97706; }
                .seo .dot-info { background:#2D74C4; }
                .seo .issue-more { color:#9C9A92; font-size:8pt; padding-top:1px; }
                .seo .fix { color:#444441; font-size:8pt; white-space:pre-line; padding-top:2px; font-weight:normal; }
                .seo .bucket-label { font-weight:bold; font-size:10pt; margin:10px 0 2px; page-break-after:avoid; }
                .seo .bucket-advice { color:#6B7280; font-size:8.5pt; margin:0 0 5px; page-break-after:avoid; }
                .seo .ai-meta { font-size:8pt; }
                .seo .bench-win { color:#0F6E56; font-weight:bold; }
                .seo .stale { background:#FAEEDA; border-radius:5px; padding:6px 10px; margin:6px 0; font-size:8.5pt; color:#854F0B; }
                .seo .site-line-label { font-weight:bold; }
                .seo .site-line-urls { color:#6B7280; font-family:monospace; font-size:7.5pt; word-break:break-all; padding-top:1px; }
                .seo .kw { font-weight:bold; }
                .seo .kw-top { display:inline-block; padding:1px 8px; border-radius:10px; font-weight:bold; color:#0F6E56; background:#E1F5EE; }
                .seo .delta-up { color:#0F6E56; }
                .seo .delta-down { color:#A32D2D; }
                .seo .mono-box { border:1px solid #E3E6E5 !important; border-radius:5px; background:#FBFCFB; padding:8px 12px; margin-top:6px; font-size:8pt; font-family:monospace; white-space:pre-line; }
                .seo .okbox { background:#E1F5EE; border-radius:5px; padding:8px 12px; margin-top:10px; page-break-inside:avoid; }
                .seo .okbox-head { color:#0F6E56; font-weight:bold; font-size:9.5pt; }
                .seo .okbox-paths { color:#6B7280; font-size:7.5pt; font-family:monospace; padding-top:3px; }
                .seo .capnote { color:#6B7280; font-size:8pt; padding:4px 0 0; }
                .seo .closing { margin-top:14px; border-top:1px solid #E5E7EB; padding-top:6px; font-size:7.5pt; color:#9C9A92; font-style:italic; }
            </style>

            <div class="seo">
                <!-- Header -->
                <table style="width:100%;">
                    <tr>
                        <td style="width:55%; vertical-align:top;">
                            <img t-if="res_company.logo"
                                 t-att-src="image_data_uri(res_company.logo)"
                                 style="max-height:45px; max-width:220px; margin-bottom:6px;"/>
                            <div class="est-name" t-field="res_company.name"/>
                            <div class="est-sub">
                                <span t-field="res_company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                                <span t-if="res_company.vat"> · VAT <span t-field="res_company.vat"/></span>
                            </div>
                        </td>
                        <td style="width:45%; vertical-align:top;">
                            <div class="title">SEO AUDIT</div>
                            <div style="text-align:right; margin-top:5px;">
                                <span t-if="full" class="type-badge" style="background:#E3EEFA; color:#1D5CA3; margin-right:4px;">Complete</span>
                                <span t-attf-class="type-badge type-{{score_cls}}"><t t-out="score_label"/></span>
                            </div>
                            <div class="title-meta">
                                <b><a t-att-href="doc.name" t-attf-style="color:{{brand}}; text-decoration:none;"><t t-out="doc.name"/></a></b>
                                · <b><span t-field="doc.last_crawl" t-options='{"widget": "date"}'/></b>
                            </div>
                            <div class="title-meta">
                                <t t-out="doc.page_count"/> pages audited ·
                                <t t-out="doc.discovered_count"/> URLs discovered<t t-if="doc.google_last_sync">
                                · Google data synced</t>
                            </div>
                        </td>
                    </tr>
                </table>
                <div class="rule"/>

                <!-- Score panel -->
                <table style="width:100%; page-break-inside:avoid;">
                    <tr>
                        <td style="width:108px; vertical-align:top;">
                            <div t-attf-class="score-box score-{{score_cls}}">
                                <div class="score-num"><t t-out="doc.score"/></div>
                                <div class="score-of">/ 100</div>
                            </div>
                        </td>
                        <td style="vertical-align:top; padding-left:16px;">
                            <div t-attf-class="score-word-{{score_cls}}"><t t-out="score_label"/></div>
                            <div class="muted" style="font-size:8.5pt;">Overall on-page SEO health of the audited pages.</div>
                            <t t-set="last" t-value="doc.history_ids[:1]"/>
                            <div t-if="len(doc.history_ids) &gt; 1 and last" style="font-size:9pt; padding-top:5px;">
                                <span t-attf-class="trend-{{'up' if last.score_delta &gt;= 0 else 'down'}}">
                                    <t t-out="('▲' if last.score_delta &gt;= 0 else '▼') + ' %+d' % last.score_delta"/>
                                </span>
                                <span class="muted">
                                    vs previous crawl —
                                    <t t-out="last.resolved_issue_count"/> issue(s) resolved,
                                    <t t-out="last.new_issue_count"/> new
                                    (<t t-out="len(doc.history_ids)"/> crawls tracked)
                                </span>
                            </div>
                            <table class="hbars">
                                <t t-foreach="[('Indexable', doc.indexable_pct), ('HTTPS', doc.https_pct), ('Mobile-friendly', doc.mobile_pct), ('Structured data', doc.schema_pct)]" t-as="bar">
                                    <tr>
                                        <td class="hlabel"><t t-out="bar[0]"/></td>
                                        <td>
                                            <div class="hbar">
                                                <div t-attf-class="hfill bg-{{'good' if bar[1] &gt;= 90 else ('mid' if bar[1] &gt;= 60 else 'bad')}}"
                                                     t-attf-style="width:{{max(2, min(100, bar[1]))}}%;"></div>
                                            </div>
                                        </td>
                                        <td class="hpct"><t t-out="bar[1]"/>%</td>
                                    </tr>
                                </t>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- KPI cards -->
                <table class="kpis" style="page-break-inside:avoid;">
                    <tr>
                        <td class="kpi">
                            <div class="kpi-v"><t t-out="doc.page_count"/></div>
                            <div class="kpi-l">Pages audited</div>
                        </td>
                        <td class="kpi">
                            <div class="kpi-v">
                                <t t-out="doc.issue_count"/>
                                <span t-if="doc.critical_count" class="crit-note"> · <t t-out="doc.critical_count"/> critical</span>
                            </div>
                            <div class="kpi-l">Issues found</div>
                        </td>
                        <td class="kpi">
                            <div t-attf-class="kpi-v {{'kpi-bad' if doc.error_page_count else ''}}"><t t-out="doc.error_page_count"/></div>
                            <div class="kpi-l">Pages in error</div>
                        </td>
                        <td class="kpi">
                            <t t-if="doc.checked_link_count">
                                <div t-attf-class="kpi-v {{'kpi-bad' if doc.broken_link_count else ''}}"><t t-out="doc.broken_link_count"/></div>
                                <div class="kpi-l">Broken links</div>
                            </t>
                            <t t-else="">
                                <div class="kpi-v"><t t-out="'%.2fs' % doc.avg_response_time"/></div>
                                <div class="kpi-l">Avg response</div>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Top issues (complete report: with our recommendations) -->
                <t t-set="top_issues" t-value="doc._report_top_issues()"/>
                <t t-if="top_issues">
                    <div class="section">
                        Top issues to fix<t t-if="full"> — our recommendations</t>
                    </div>
                    <div t-if="full and not any(ti.get('how_to_fix') for ti in top_issues)" class="stale">
                        This crawl predates the recommendation engine, so the how-to-fix
                        guidance is missing below. Re-crawl the site to fill it in.
                    </div>
                    <table class="lines">
                        <thead>
                            <tr>
                                <th style="width:13%;">Severity</th>
                                <th>Issue</th>
                                <th class="num" style="width:14%;">Pages affected</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="top_issues" t-as="ti">
                                <t t-set="sev_cls" t-value="{'critical': 'crit', 'warning': 'warn', 'info': 'info'}[ti['severity']]"/>
                                <tr style="page-break-inside:avoid;">
                                    <td><span t-attf-class="pill pill-{{sev_cls}}"><t t-out="ti['severity']"/></span></td>
                                    <td>
                                        <div style="font-weight:bold;"><t t-out="ti['message']"/></div>
                                        <div t-if="full and ti.get('how_to_fix')" class="fix"><t t-out="ti['how_to_fix']"/></div>
                                    </td>
                                    <td class="num" style="font-weight:bold;"><t t-out="ti['page_count']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- Competitive benchmark -->
                <t t-set="bench" t-value="doc._report_benchmark()"/>
                <t t-if="bench">
                    <div class="section">
                        Competitive benchmark — rank <t t-out="bench['rank']"/> of <t t-out="bench['field_size']"/>
                    </div>
                    <div class="bucket-advice">
                        Same crawl, same metrics, run on each site.
                        This site leads on <t t-out="bench['wins']"/> of <t t-out="bench['total']"/> measured criteria.
                    </div>
                    <table class="lines">
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th class="num" style="width:14%;">This site</th>
                                <t t-foreach="bench['competitors']" t-as="comp">
                                    <th class="num"><t t-out="comp['name']"/></th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="bench['rows']" t-as="brow">
                                <tr style="page-break-inside:avoid;">
                                    <td style="font-weight:bold;"><t t-out="brow['label']"/></td>
                                    <td t-attf-class="num {{'bench-win' if brow['we_win'] else ''}}"><t t-out="brow['ours']"/></td>
                                    <t t-foreach="brow['theirs']" t-as="cell">
                                        <td t-attf-class="num {{'bench-win' if cell['best'] else ''}}"><t t-out="cell['value']"/></td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="capnote">
                        Best value of each row in green. Backlink and AI-visibility rows
                        appear only for the sites where those scans were run.<t t-if="bench['capped']">
                        The crawl budget was reached on <t t-out="', '.join(bench['capped'])"/>,
                        so their real page count is higher than shown.</t>
                    </div>
                </t>

                <!-- Action plan by work stream -->
                <div class="section">Action plan by work stream</div>
                <table class="lines">
                    <thead>
                        <tr>
                            <th>Work stream</th>
                            <th class="num" style="width:12%;">Issues</th>
                            <th class="num" style="width:12%;">Critical</th>
                            <th class="num" style="width:13%;">Warnings</th>
                            <th class="num" style="width:16%;">Pages affected</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc._report_issue_groups()" t-as="group">
                            <tr style="page-break-inside:avoid;">
                                <td style="font-weight:bold;"><t t-out="group['category']"/></td>
                                <td class="num"><t t-out="group['count']"/></td>
                                <td t-attf-class="num {{'zero' if not group['critical'] else ''}}"
                                    t-attf-style="{{'color:#A32D2D; font-weight:bold;' if group['critical'] else ''}}"><t t-out="group['critical']"/></td>
                                <td t-attf-class="num {{'zero' if not group['warning'] else ''}}"
                                    t-attf-style="{{'color:#854F0B;' if group['warning'] else ''}}"><t t-out="group['warning']"/></td>
                                <td class="num"><t t-out="group['page_count']"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Keyword opportunities (complete report) -->
                <t t-if="full">
                    <t t-set="kw_buckets" t-value="doc._report_keyword_buckets()"/>
                    <t t-if="kw_buckets">
                        <div class="section">Keyword opportunities — where to push</div>
                        <t t-foreach="kw_buckets" t-as="bucket">
                            <div class="bucket-label"><t t-out="bucket['label']"/> (<t t-out="len(bucket['keywords'])"/>)</div>
                            <div class="bucket-advice"><t t-out="bucket['advice']"/></div>
                            <table class="lines">
                                <thead>
                                    <tr>
                                        <th>Keyword</th>
                                        <th class="num" style="width:12%;">Position</th>
                                        <th class="num" style="width:14%;">Volume/month</th>
                                        <th class="num" style="width:13%;">Clicks (28d)</th>
                                        <th style="width:30%;">Ranking page</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="bucket['keywords']" t-as="kw">
                                        <tr style="page-break-inside:avoid;">
                                            <td class="kw"><t t-out="kw['name']"/></td>
                                            <td class="num" style="font-weight:bold;"><t t-out="'%.1f' % kw['position']"/></td>
                                            <td class="num"><t t-out="kw['volume'] or '-'"/></td>
                                            <td class="num"><t t-out="kw['clicks']"/></td>
                                            <td class="path"><t t-out="kw['best_page']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>

                    <!-- Keyword cannibalization (complete report) -->
                    <t t-set="cannibal" t-value="doc._report_cannibalization_rows()"/>
                    <t t-if="cannibal">
                        <div class="section">Keyword cannibalization — pages competing against each other</div>
                        <div class="bucket-advice">
                            Queries where several of your own pages rank: Google splits the
                            clicks and often shows the weaker page. Each row states which
                            page to keep.
                        </div>
                        <table class="lines">
                            <thead>
                                <tr>
                                    <th style="width:11%;">Severity</th>
                                    <th>Query &amp; competing pages</th>
                                    <th class="num" style="width:11%;">Impressions</th>
                                    <th class="num" style="width:9%;">Clicks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cannibal" t-as="can">
                                    <t t-set="can_cls" t-value="{'high': 'crit', 'medium': 'warn', 'low': 'info'}[can['severity']]"/>
                                    <tr style="page-break-inside:avoid;">
                                        <td><span t-attf-class="pill pill-{{can_cls}}"><t t-out="can['severity']"/></span></td>
                                        <td>
                                            <div style="font-weight:bold;"><t t-out="can['query']"/></div>
                                            <t t-foreach="can['pages']" t-as="cpage">
                                                <div class="site-line-urls"><t t-out="cpage"/></div>
                                            </t>
                                            <div class="fix"><t t-out="can['recommendation']"/></div>
                                        </td>
                                        <td class="num" style="font-weight:bold;"><t t-out="can['impressions']"/></td>
                                        <td class="num"><t t-out="can['clicks']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Internal linking plan (complete report) -->
                    <t t-set="links" t-value="doc._report_link_suggestions()"/>
                    <t t-if="links">
                        <div class="section">Internal linking plan</div>
                        <t t-set="orphans" t-value="doc._orphan_pages()"/>
                        <div class="bucket-advice">
                            Concrete links to add: each row pairs a page with internal
                            authority to a page that lacks internal support, on a topic
                            they already share.<t t-if="orphans">
                            <b> <t t-out="len(orphans)"/> page(s) currently have no
                            internal link at all</b> — they exist only in the sitemap
                            and receive no ranking signal from the rest of the site.</t>
                        </div>
                        <table class="lines">
                            <thead>
                                <tr>
                                    <th style="width:27%;">Add a link on</th>
                                    <th style="width:27%;">Pointing to</th>
                                    <th style="width:14%;">Anchor</th>
                                    <th>Why</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="links" t-as="link">
                                    <tr style="page-break-inside:avoid;">
                                        <td class="path"><t t-out="link['source']"/></td>
                                        <td class="path"><t t-out="link['target']"/></td>
                                        <td style="font-weight:bold; font-size:8pt;"><t t-out="link['anchor']"/></td>
                                        <td class="ai-meta"><t t-out="link['reason']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Ready-to-apply AI metas (complete report) -->
                    <t t-set="ai_rows" t-value="doc._report_ai_meta_rows()"/>
                    <t t-if="ai_rows">
                        <div class="section">Ready-to-apply title &amp; meta rewrites</div>
                        <table class="lines">
                            <thead>
                                <tr>
                                    <th style="width:26%;">Page</th>
                                    <th style="width:32%;">Suggested title</th>
                                    <th>Suggested meta description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="ai_rows" t-as="row">
                                    <tr style="page-break-inside:avoid;">
                                        <td class="path"><t t-out="row['path']"/></td>
                                        <td class="ai-meta" style="font-weight:bold;"><t t-out="row['title']"/></td>
                                        <td class="ai-meta"><t t-out="row['meta']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- Site-level issues -->
                <t t-set="site_lines" t-value="doc._report_site_issue_lines()"/>
                <t t-if="site_lines">
                    <div class="section">Site-level issues (<t t-out="len(site_lines)"/>)</div>
                    <table class="lines">
                        <tbody>
                            <t t-foreach="site_lines" t-as="sline">
                                <tr style="page-break-inside:avoid;">
                                    <td>
                                        <div class="site-line-label"><t t-out="sline['label']"/></div>
                                        <div t-if="sline['urls']" class="site-line-urls"><t t-out="sline['urls']"/></div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- Keywords -->
                <t t-if="doc.keyword_ids">
                    <div class="section">Tracked keywords</div>
                    <table class="lines">
                        <thead>
                            <tr>
                                <th>Keyword</th>
                                <th class="num" style="width:11%;">Position</th>
                                <th class="num" style="width:11%;">Δ places</th>
                                <th class="num" style="width:12%;">Clicks (28d)</th>
                                <th class="num" style="width:13%;">Impressions</th>
                                <th class="num" style="width:14%;">Volume/month</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.keyword_ids" t-as="kw">
                                <tr style="page-break-inside:avoid;">
                                    <td class="kw"><t t-out="kw.name"/></td>
                                    <td class="num">
                                        <t t-if="kw.position and kw.position &lt; 101">
                                            <span t-attf-class="{{'kw-top' if kw.position &lt;= 10 else ''}}" style="font-weight:bold;"><t t-out="'%.1f' % kw.position"/></span>
                                        </t>
                                        <t t-elif="kw.position &gt;= 101">100+</t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td t-attf-class="num {{'delta-up' if kw.position_delta &gt; 0 else ('delta-down' if kw.position_delta &lt; 0 else 'zero')}}"
                                        t-out="('%+.1f' % kw.position_delta) if kw.position_delta else '-'"/>
                                    <td class="num" t-out="kw.clicks"/>
                                    <td class="num" t-out="kw.impressions"/>
                                    <td class="num" t-out="kw.volume or '-'"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- AI Visibility -->
                <t t-if="doc.ai_visibility_date or doc.ai_prompt_ids.mapped('result_ids')">
                    <div class="section">AI Visibility (GEO)</div>
                    <table class="kpis" style="page-break-inside:avoid; margin-top:2px;">
                        <tr>
                            <td class="kpi">
                                <div class="kpi-v"><t t-out="doc.ai_visibility_pct"/>%</div>
                                <div class="kpi-l">Brand mentioned</div>
                            </td>
                            <td class="kpi">
                                <div class="kpi-v"><t t-out="doc.ai_cited_pct"/>%</div>
                                <div class="kpi-l">Site cited</div>
                            </td>
                            <td class="kpi">
                                <div class="kpi-v"><t t-out="doc.ai_mentions_chatgpt"/></div>
                                <div class="kpi-l">ChatGPT prompts</div>
                            </td>
                            <td class="kpi">
                                <div class="kpi-v"><t t-out="doc.ai_mentions_google"/></div>
                                <div class="kpi-l">AI Overview prompts</div>
                            </td>
                        </tr>
                    </table>
                    <div t-if="doc.ai_share_of_voice" class="mono-box"><t t-out="doc.ai_share_of_voice"/></div>
                </t>

                <!-- Page detail (worst 50) -->
                <t t-set="page_rows" t-value="doc._report_page_rows()"/>
                <t t-set="shown_rows" t-value="page_rows[:50]"/>
                <t t-if="page_rows">
                    <div class="section">Pages needing work (<t t-out="len(page_rows)"/>)</div>
                    <table class="lines">
                        <thead>
                            <tr>
                                <th style="width:31%;">Page</th>
                                <th class="num" style="width:8%;">HTTP</th>
                                <th style="width:9%; text-align:center;">Score</th>
                                <th>Top issues</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="shown_rows" t-as="row">
                                <tr style="page-break-inside:avoid;">
                                    <td class="path"><t t-out="row['path']"/></td>
                                    <td t-attf-class="num {{'kpi-bad' if row['status'] &gt;= 400 or not row['status'] else ''}}"
                                        t-attf-style="{{'font-weight:bold;' if row['status'] &gt;= 400 or not row['status'] else ''}}"><t t-out="row['status'] or '-'"/></td>
                                    <td class="center">
                                        <span t-attf-class="score-pill score-{{'good' if row['score'] &gt;= 80 else ('mid' if row['score'] &gt;= 60 else 'bad')}}"><t t-out="row['score']"/></span>
                                    </td>
                                    <td>
                                        <div t-if="row['error']" style="color:#A32D2D; font-weight:bold; padding:1px 0;"><t t-out="row['error']"/></div>
                                        <t t-foreach="row['issues']" t-as="iss">
                                            <t t-set="dot_cls" t-value="{'critical': 'crit', 'warning': 'warn', 'info': 'info'}[iss['severity']]"/>
                                            <div style="padding:1px 0;">
                                                <span t-attf-class="dot dot-{{dot_cls}}"></span><t t-out="iss['message']"/>
                                            </div>
                                        </t>
                                        <div t-if="row['more']" class="issue-more">+ <t t-out="row['more']"/> more — full detail in the app</div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="len(page_rows) &gt; 50" class="capnote">
                        + <t t-out="len(page_rows) - 50"/> other page(s) with minor issues — full list in the SEO Suite app.
                    </div>
                </t>

                <!-- Clean pages -->
                <t t-set="clean_pages" t-value="doc._report_clean_pages()"/>
                <div t-if="clean_pages" class="okbox">
                    <span class="okbox-head">✓ <t t-out="len(clean_pages)"/> page(s) with no detected issues</span>
                    <div class="okbox-paths"><t t-out="' · '.join(clean_pages)"/></div>
                </div>

                <div class="closing">
                    Full issue detail, how-to-fix guidance and crawl history are available in the SEO Suite app.
                    Generated with SEO Suite for Odoo.
                </div>
            </div>
        </div>

        <!-- Page footer: numbering (spans filled by Odoo's PDF engine). -->
        <div class="footer" style="text-align:center; font-size:8pt; color:#9C9A92; padding-top:4px;">
            Page <span class="page"/> / <span class="topage"/>
        </div>
    </template>
</odoo>
