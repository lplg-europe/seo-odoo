<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_seo_auto_crawl" model="ir.cron">
            <field name="name">SEO Suite: scheduled site crawls</field>
            <field name="model_id" ref="model_seo_site"/>
            <field name="state">code</field>
            <field name="code">model._cron_crawl()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
