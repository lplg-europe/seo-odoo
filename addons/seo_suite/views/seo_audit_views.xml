<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_seo_audit_list" model="ir.ui.view">
        <field name="name">seo.audit.list</field>
        <field name="model">seo.audit</field>
        <field name="arch" type="xml">
            <list string="SEO Audits"
                  decoration-danger="issue_count &gt; 0"
                  decoration-success="issue_count == 0 and audit_date">
                <field name="name"/>
                <field name="status_code"/>
                <field name="title"/>
                <field name="word_count"/>
                <field name="issue_count"/>
                <field name="score" widget="progressbar" optional="show"/>
                <field name="site_id" optional="hide"/>
                <field name="audit_date"/>
            </list>
        </field>
    </record>

    <record id="view_seo_audit_form" model="ir.ui.view">
        <field name="name">seo.audit.form</field>
        <field name="model">seo.audit</field>
        <field name="arch" type="xml">
            <form string="SEO Audit">
                <header>
                    <button name="action_run_audit" type="object"
                            string="Run audit" class="btn-primary"
                            icon="fa-search"/>
                    <button name="action_run_pagespeed" type="object"
                            string="Run PageSpeed" icon="fa-tachometer"
                            help="Google PageSpeed Insights (mobile + desktop). Takes ~30-60s."/>
                    <button name="action_ai_suggest_meta" type="object"
                            string="AI: title &amp; meta" icon="fa-magic"
                            invisible="not audit_date"
                            help="AI-written title, meta description, H1, target keyword and content topic (BYO key, SEO → Configuration)."/>
                    <button name="action_ai_improve_headings" type="object"
                            string="AI: headings" icon="fa-magic"
                            invisible="not headings_outline"/>
                    <button name="action_ai_generate_jsonld" type="object"
                            string="AI: JSON-LD" icon="fa-magic"
                            invisible="not audit_date"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="URL"/>
                        <h1><field name="name" placeholder="https://example.com"/></h1>
                    </div>
                    <group>
                        <group string="Result">
                            <field name="status_code"/>
                            <field name="final_url" widget="url"/>
                            <field name="audit_date"/>
                            <field name="issue_count"/>
                            <field name="score"/>
                            <field name="link_score"/>
                            <field name="site_id" invisible="not site_id"/>
                            <field name="error" invisible="not error"/>
                        </group>
                        <group string="Performance">
                            <field name="response_time"/>
                            <field name="page_size_kb"/>
                            <field name="redirect_count"/>
                            <field name="redirect_chain"
                                   invisible="not redirect_chain"/>
                            <field name="is_https"/>
                            <field name="viewport"/>
                        </group>
                    </group>
                    <group string="Google preview" invisible="not audit_date">
                        <field name="google_preview" nolabel="1"/>
                    </group>
                    <group>
                        <group string="Content">
                            <field name="word_count"/>
                            <field name="reading_time"/>
                            <field name="h2_count"/>
                            <field name="internal_links"/>
                            <field name="external_links"/>
                            <field name="images"/>
                            <field name="images_without_alt"/>
                            <field name="text_ratio"/>
                            <field name="flesch_score"/>
                            <field name="flesch_label"/>
                        </group>
                        <group string="Social &amp; Structured data">
                            <field name="og_status"/>
                            <field name="schema_count"/>
                            <field name="schema_types"/>
                            <field name="hreflang_count"/>
                            <field name="lang"/>
                            <field name="mixed_content"/>
                            <field name="unsafe_blank_links"/>
                        </group>
                    </group>
                    <group string="On-page">
                        <field name="title"/>
                        <field name="title_length"/>
                        <field name="meta_description"/>
                        <field name="meta_description_length"/>
                        <field name="h1"/>
                        <field name="headings_outline"/>
                        <field name="canonical"/>
                        <field name="meta_robots"/>
                        <field name="top_keywords"/>
                    </group>
                    <group string="Google Search Console &amp; Analytics"
                           invisible="not gsc_impressions and not index_state and not ga_views">
                        <group>
                            <field name="gsc_clicks"/>
                            <field name="gsc_impressions"/>
                            <field name="gsc_ctr"/>
                            <field name="gsc_position"/>
                            <field name="ga_views"/>
                            <field name="ga_sessions"/>
                            <field name="ga_users"/>
                            <field name="ga_engagement"/>
                        </group>
                        <group>
                            <field name="index_verdict"/>
                            <field name="index_state"/>
                            <field name="google_canonical"/>
                            <field name="google_last_crawl"/>
                        </group>
                    </group>
                    <group string="AI suggestions" invisible="not ai_date">
                        <group>
                            <field name="ai_title"/>
                            <field name="ai_meta_description"/>
                            <field name="ai_h1"/>
                            <field name="ai_keyword"/>
                            <field name="ai_topic"/>
                            <field name="ai_date"/>
                        </group>
                        <group>
                            <field name="ai_headings"/>
                            <field name="ai_jsonld"/>
                        </group>
                    </group>
                    <group string="PageSpeed Insights (Google)"
                           invisible="not psi_date">
                        <group>
                            <field name="psi_date"/>
                            <field name="psi_perf_mobile"/>
                            <field name="psi_seo_mobile"/>
                            <field name="psi_a11y_mobile"/>
                            <field name="psi_bp_mobile"/>
                        </group>
                        <group>
                            <field name="psi_lcp"/>
                            <field name="psi_cls"/>
                            <field name="psi_tbt"/>
                            <field name="psi_fcp"/>
                            <field name="psi_speed_index"/>
                            <field name="psi_perf_desktop"/>
                            <field name="psi_seo_desktop"/>
                        </group>
                        <group>
                            <field name="psi_dom_size"/>
                            <field name="psi_total_weight_kb"/>
                            <field name="psi_render_blocking"/>
                            <field name="psi_long_tasks"/>
                        </group>
                    </group>
                    <group string="Detected issues">
                        <field name="issue_ids" nolabel="1" readonly="1">
                            <list decoration-danger="severity == 'critical'"
                                  decoration-warning="severity == 'warning'"
                                  decoration-info="severity == 'info'">
                                <field name="severity"/>
                                <field name="category"/>
                                <field name="message"/>
                                <field name="how_to_fix" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seo_audit" model="ir.actions.act_window">
        <field name="name">SEO Audits</field>
        <field name="res_model">seo.audit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run your first SEO audit</p>
            <p>Enter a URL, click "Run audit" and SEO Suite analyzes the page
               (title, meta, H1, canonical, links, images) and lists the detected issues.</p>
        </field>
    </record>

    <menuitem id="menu_seo_root" name="SEO"
              web_icon="seo_suite,static/description/icon.png" sequence="90"/>
    <menuitem id="menu_seo_audit" name="Audits"
              parent="menu_seo_root" action="action_seo_audit" sequence="10"/>
    <menuitem id="menu_seo_reports" name="Reports"
              parent="menu_seo_root" sequence="20"/>

</odoo>
