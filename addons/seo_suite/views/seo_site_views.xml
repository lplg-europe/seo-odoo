<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_seo_site_list" model="ir.ui.view">
        <field name="name">seo.site.list</field>
        <field name="model">seo.site</field>
        <field name="arch" type="xml">
            <list string="SEO Sites"
                  decoration-danger="error_page_count &gt; 0"
                  decoration-success="issue_count == 0 and page_count &gt; 0">
                <field name="name"/>
                <field name="page_count"/>
                <field name="score" widget="progressbar"/>
                <field name="issue_count"/>
                <field name="error_page_count"/>
                <field name="site_issue_count"/>
                <field name="last_crawl"/>
            </list>
        </field>
    </record>

    <record id="view_seo_site_form" model="ir.ui.view">
        <field name="name">seo.site.form</field>
        <field name="model">seo.site</field>
        <field name="arch" type="xml">
            <form string="SEO Site">
                <header>
                    <button name="action_crawl" type="object"
                            string="Crawl site" class="btn-primary"
                            icon="fa-globe"/>
                    <button name="action_sync_google" type="object"
                            string="Sync Google data" icon="fa-google"
                            invisible="page_count == 0"
                            help="Pull clicks/impressions/position from Search Console (and GA4 traffic if configured) for every crawled page."/>
                    <button name="action_check_indexation" type="object"
                            string="Check indexation" icon="fa-check-square-o"
                            invisible="page_count == 0"
                            help="Google URL Inspection per page: is it really indexed? Takes ~1-2s per page (max 50)."/>
                    <button name="action_ai_suggest_missing_metas" type="object"
                            string="AI: missing metas" icon="fa-magic"
                            invisible="page_count == 0"
                            help="AI title/meta suggestions for every crawled page missing a meta description (8 pages per click, BYO key)."/>
                    <button name="action_fetch_backlinks" type="object"
                            string="Fetch backlinks" icon="fa-external-link"
                            help="Backlink profile overview via DataForSEO (paid BYO key, ~$0.02)."/>
                    <button name="action_send_report" type="object"
                            string="Send report now" icon="fa-envelope-o"
                            invisible="not report_email or not last_crawl"
                            help="Email the audit report (PDF + summary) to the configured recipients — sent by this Odoo instance."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_audits" type="object"
                                class="oe_stat_button" icon="fa-files-o"
                                invisible="page_count == 0">
                            <field name="page_count" widget="statinfo"
                                   string="Pages"/>
                        </button>
                        <button name="action_view_issues" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="page_count == 0">
                            <field name="issue_count" widget="statinfo"
                                   string="Issues"/>
                        </button>
                        <button name="action_view_issues" type="object"
                                class="oe_stat_button" icon="fa-exclamation-circle"
                                invisible="critical_count == 0">
                            <field name="critical_count" widget="statinfo"
                                   string="Critical"/>
                        </button>
                        <button name="action_view_history" type="object"
                                class="oe_stat_button" icon="fa-line-chart"
                                invisible="history_count &lt; 2">
                            <field name="history_count" widget="statinfo"
                                   string="Crawls"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Site URL"/>
                        <h1><field name="name" placeholder="https://example.com"/></h1>
                    </div>
                    <group>
                        <group string="Crawl options">
                            <field name="max_pages"/>
                            <field name="use_sitemap"/>
                            <field name="follow_links"/>
                            <field name="check_links"/>
                            <field name="auto_crawl_interval"/>
                            <field name="gsc_property"
                                   placeholder="auto-detected on first sync"/>
                            <field name="ga4_property_id"
                                   placeholder="e.g. 123456789"/>
                            <field name="report_frequency"/>
                            <field name="report_email"
                                   invisible="report_frequency == 'none'"
                                   required="report_frequency != 'none'"
                                   placeholder="client@example.com"/>
                            <field name="report_last_sent"
                                   invisible="not report_last_sent"/>
                        </group>
                        <group string="Result">
                            <field name="last_crawl"/>
                            <field name="discovered_count"/>
                            <field name="error_page_count"/>
                            <field name="score"/>
                            <field name="critical_count"/>
                            <field name="warning_count"/>
                            <field name="info_count"/>
                            <field name="avg_response_time"/>
                            <field name="avg_word_count"/>
                            <field name="indexable_pct"/>
                            <field name="https_pct"/>
                            <field name="mobile_pct"/>
                            <field name="schema_pct"/>
                            <field name="checked_link_count"
                                   invisible="not checked_link_count"/>
                            <field name="broken_link_count"
                                   invisible="not checked_link_count"/>
                            <field name="google_last_sync"
                                   invisible="not google_last_sync"/>
                            <field name="indexed_page_count"
                                   invisible="not google_last_sync and not indexed_page_count"/>
                            <field name="not_indexed_page_count"
                                   invisible="not google_last_sync and not indexed_page_count"/>
                        </group>
                    </group>
                    <group string="Backlinks (DataForSEO)"
                           invisible="not bl_date">
                        <group>
                            <field name="bl_rank"/>
                            <field name="bl_backlinks"/>
                            <field name="bl_referring_domains"/>
                            <field name="bl_referring_pages"/>
                        </group>
                        <group>
                            <field name="bl_dofollow"/>
                            <field name="bl_broken_backlinks"/>
                            <field name="bl_spam_score"/>
                            <field name="bl_first_seen"/>
                            <field name="bl_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pages" name="pages">
                            <field name="audit_ids" readonly="1">
                                <list decoration-danger="error or status_code &gt;= 400"
                                      decoration-warning="issue_count &gt; 2">
                                    <field name="name"/>
                                    <field name="status_code"/>
                                    <field name="title" optional="show"/>
                                    <field name="word_count" optional="show"/>
                                    <field name="issue_count"/>
                                    <field name="score" widget="progressbar"/>
                                    <field name="link_score" optional="show"/>
                                    <field name="click_depth" optional="hide"/>
                                    <field name="gsc_clicks" optional="show"/>
                                    <field name="gsc_position" optional="show"/>
                                    <field name="ga_views" optional="hide"/>
                                    <field name="index_status" optional="show"
                                           widget="badge"
                                           decoration-success="index_status == 'indexed'"
                                           decoration-danger="index_status in ('not_indexed', 'error')"/>
                                    <field name="index_state" optional="show"/>
                                    <field name="response_time" optional="hide"/>
                                    <field name="page_size_kb" optional="hide"/>
                                    <field name="flesch_score" optional="hide"/>
                                    <field name="og_status" optional="hide"/>
                                    <field name="error" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Site issues" name="site_issues">
                            <field name="site_issue_count" invisible="1"/>
                            <field name="site_issues" nolabel="1"/>
                        </page>
                        <page string="Cannibalization" name="cannibalization">
                            <div class="alert alert-info" role="alert">
                                When several of your pages rank for the same query,
                                Google splits the clicks and picks the weaker page.
                                This asks Search Console for the query × page
                                breakdown and tells you which page to keep.
                            </div>
                            <button name="action_check_cannibalization" type="object"
                                    string="Check cannibalization (Search Console)"
                                    icon="fa-clone" class="btn-secondary mb-2"/>
                            <field name="cannibalization_date" readonly="1"
                                   invisible="not cannibalization_date"/>
                            <field name="cannibalization_ids" nolabel="1" readonly="1">
                                <list decoration-danger="severity == 'high'"
                                      decoration-warning="severity == 'medium'">
                                    <field name="query"/>
                                    <field name="severity"/>
                                    <field name="page_count"/>
                                    <field name="impressions"/>
                                    <field name="clicks"/>
                                    <field name="best_position"/>
                                    <field name="winner_url" optional="show"/>
                                    <button name="action_view_pages" type="object"
                                            icon="fa-files-o" title="See the competing pages"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal linking" name="internal_linking">
                            <div class="alert alert-info" role="alert">
                                Crosses the internal link graph, the internal PageRank
                                and the Search Console demand to answer the question
                                no tool answers concretely: which exact link should
                                you add, and with which anchor.
                            </div>
                            <button name="action_suggest_internal_links" type="object"
                                    string="Suggest internal links"
                                    icon="fa-sitemap" class="btn-secondary mb-2"/>
                            <field name="link_suggestion_date" readonly="1"
                                   invisible="not link_suggestion_date"/>
                            <field name="link_suggestion_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="source_url"/>
                                    <field name="target_url"/>
                                    <field name="anchor"/>
                                    <field name="score"/>
                                    <field name="source_link_score" optional="show"/>
                                    <field name="target_inbound" optional="show"/>
                                    <field name="target_impressions" optional="show"/>
                                    <field name="reason" optional="hide"/>
                                    <button name="action_open_target" type="object"
                                            icon="fa-arrow-right" title="Open the target page"/>
                                </list>
                            </field>
                        </page>
                        <page string="Competitors" name="competitors">
                            <div class="alert alert-info" role="alert">
                                Link the competitors you want to be compared to.
                                They are regular SEO sites: create them, crawl them,
                                and the audit report gains a "Competitive benchmark"
                                section ranking this site against them on score,
                                content depth, technical health, backlinks and AI
                                visibility.
                            </div>
                            <button name="action_crawl_competitors" type="object"
                                    string="Re-crawl all competitors"
                                    icon="fa-refresh" class="btn-secondary mb-2"
                                    invisible="competitor_count == 0"/>
                            <field name="competitor_count" invisible="1"/>
                            <field name="competitor_ids" nolabel="1"
                                   domain="[('id', '!=', id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="page_count"/>
                                    <field name="score" widget="progressbar"/>
                                    <field name="issue_count"/>
                                    <field name="avg_word_count" optional="show"/>
                                    <field name="bl_rank" optional="hide"/>
                                    <field name="ai_visibility_pct" optional="hide"/>
                                    <field name="last_crawl"/>
                                </list>
                            </field>
                        </page>
                        <page string="Keywords" name="keywords">
                            <button name="action_fetch_volumes" type="object"
                                    string="Fetch volumes (DataForSEO)"
                                    icon="fa-usd" class="btn-secondary mb-2"
                                    invisible="keyword_count == 0"/>
                            <field name="keyword_ids"
                                   context="{'default_site_id': id}">
                                <list editable="bottom"
                                      decoration-success="position and position &lt;= 10"
                                      decoration-muted="position &gt;= 101">
                                    <field name="name"/>
                                    <field name="position"/>
                                    <field name="position_delta"/>
                                    <field name="clicks"/>
                                    <field name="impressions"/>
                                    <field name="volume" optional="show"/>
                                    <field name="best_page" optional="show"/>
                                    <field name="our_position_serp" optional="hide"/>
                                    <button name="action_view_history" type="object"
                                            icon="fa-line-chart" title="Position history"/>
                                    <button name="action_analyze_serp" type="object"
                                            icon="fa-search" title="Analyze live SERP (DataForSEO, paid)"/>
                                </list>
                            </field>
                        </page>
                        <page string="AI Visibility" name="ai_visibility">
                            <group>
                                <group string="Setup">
                                    <field name="brand_name"/>
                                    <field name="ai_competitors"
                                           placeholder="Competitor A, Competitor B"/>
                                </group>
                                <group string="Results">
                                    <field name="ai_visibility_pct"/>
                                    <field name="ai_cited_pct"/>
                                    <field name="ai_mentions_chatgpt"/>
                                    <field name="ai_mentions_google"/>
                                    <field name="ai_visibility_date"/>
                                </group>
                            </group>
                            <button name="action_ai_visibility_scan" type="object"
                                    string="Scan AI mentions (DataForSEO)"
                                    icon="fa-rss" class="btn-secondary mb-2"
                                    help="Which prompts make ChatGPT / Google AI Overview cite this domain (US/en dataset) + brand share of voice vs competitors. Paid, ~$0.05-0.20."/>
                            <field name="ai_prompt_ids"
                                   context="{'default_site_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="mention_summary"/>
                                    <field name="web_search" optional="hide"/>
                                    <field name="last_run"/>
                                    <button name="action_run" type="object"
                                            icon="fa-play"
                                            title="Ask ChatGPT, Claude, Gemini and Perplexity (paid)"/>
                                </list>
                            </field>
                            <group string="Prompts citing this domain"
                                   invisible="not ai_mentions_detail">
                                <field name="ai_mentions_detail" nolabel="1"
                                       class="font-monospace"/>
                            </group>
                            <group string="AI share of voice"
                                   invisible="not ai_share_of_voice">
                                <field name="ai_share_of_voice" nolabel="1"
                                       class="font-monospace"/>
                            </group>
                        </page>
                        <page string="Search queries" name="search_queries"
                              invisible="not google_last_sync">
                            <field name="gsc_top_queries" nolabel="1"
                                   class="o_field_text font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seo_site" model="ir.actions.act_window">
        <field name="name">SEO Sites</field>
        <field name="res_model">seo.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crawl your first site</p>
            <p>Enter the root URL and click "Crawl site": SEO Suite discovers the
               pages (sitemap.xml + internal links), audits each one and reports
               duplicate titles, broken pages and other site-level issues.</p>
        </field>
    </record>

    <menuitem id="menu_seo_site" name="Sites"
              parent="menu_seo_root" action="action_seo_site" sequence="5"/>

</odoo>
