<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_seo_report_wizard_form" model="ir.ui.view">
        <field name="name">seo.report.wizard.form</field>
        <field name="model">seo.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick SEO audit">
                <p class="text-muted">
                    Paste a website URL: SEO Suite crawls it and opens the
                    printable audit report — perfect for a "free SEO audit"
                    prospect offer. The crawl takes about a minute.
                </p>
                <group>
                    <field name="url" placeholder="https://prospect-website.be"/>
                    <field name="max_pages"/>
                    <field name="check_links"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Crawl &amp; print report"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_seo_report_wizard" model="ir.actions.act_window">
        <field name="name">Quick audit</field>
        <field name="res_model">seo.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_seo_report_wizard" name="Quick audit"
              parent="menu_seo_reports" action="action_seo_report_wizard"
              sequence="1"/>

</odoo>
