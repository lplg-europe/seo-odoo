<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_seo_keyword_list" model="ir.ui.view">
        <field name="name">seo.keyword.list</field>
        <field name="model">seo.keyword</field>
        <field name="arch" type="xml">
            <list string="Tracked keywords" editable="bottom"
                  decoration-success="position and position &lt;= 10"
                  decoration-muted="position &gt;= 101">
                <field name="name"/>
                <field name="site_id"/>
                <field name="origin" optional="show" widget="badge"
                       decoration-info="origin == 'discovered'"/>
                <field name="position"/>
                <field name="position_delta"/>
                <field name="clicks"/>
                <field name="impressions"/>
                <field name="ctr" optional="hide"/>
                <field name="volume" optional="show"/>
                <field name="cpc" optional="hide"/>
                <field name="competition" optional="hide"/>
                <field name="best_page" optional="show"/>
                <field name="our_position_serp" optional="hide"/>
                <field name="last_sync" optional="hide"/>
                <button name="action_view_history" type="object"
                        icon="fa-line-chart" title="Position history"/>
                <button name="action_analyze_serp" type="object"
                        icon="fa-search" title="Analyze live SERP (DataForSEO, paid)"/>
            </list>
        </field>
    </record>

    <record id="view_seo_keyword_form" model="ir.ui.view">
        <field name="name">seo.keyword.form</field>
        <field name="model">seo.keyword</field>
        <field name="arch" type="xml">
            <form string="Tracked keyword">
                <header>
                    <button name="action_analyze_serp" type="object"
                            string="Analyze SERP" icon="fa-search"
                            help="Live Google SERP snapshot via DataForSEO (paid, ~$0.001)"/>
                    <button name="action_view_history" type="object"
                            string="Position history" icon="fa-line-chart"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. agence seo wavre"/></h1>
                    </div>
                    <group>
                        <group string="Search Console (28 days)">
                            <field name="site_id"/>
                            <field name="position"/>
                            <field name="position_delta"/>
                            <field name="clicks"/>
                            <field name="impressions"/>
                            <field name="ctr"/>
                            <field name="best_page" widget="url"/>
                            <field name="last_sync"/>
                        </group>
                        <group string="Market (DataForSEO)">
                            <field name="volume"/>
                            <field name="cpc"/>
                            <field name="competition"/>
                            <field name="our_position_serp"/>
                            <field name="serp_date"/>
                        </group>
                    </group>
                    <group string="Live SERP snapshot" invisible="not serp_snapshot">
                        <field name="serp_snapshot" nolabel="1"
                               class="font-monospace"/>
                    </group>
                    <group string="History">
                        <field name="history_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="position"/>
                                <field name="clicks"/>
                                <field name="impressions"/>
                                <field name="page" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_seo_keyword_history_graph" model="ir.ui.view">
        <field name="name">seo.keyword.history.graph</field>
        <field name="model">seo.keyword.history</field>
        <field name="arch" type="xml">
            <graph string="Position trend" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="position" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_seo_keyword_history_list" model="ir.ui.view">
        <field name="name">seo.keyword.history.list</field>
        <field name="model">seo.keyword.history</field>
        <field name="arch" type="xml">
            <list string="Keyword history" create="false">
                <field name="date"/>
                <field name="keyword_id"/>
                <field name="site_id" optional="hide"/>
                <field name="position"/>
                <field name="clicks"/>
                <field name="impressions"/>
                <field name="page" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_seo_keyword_search" model="ir.ui.view">
        <field name="name">seo.keyword.search</field>
        <field name="model">seo.keyword</field>
        <field name="arch" type="xml">
            <search string="Keywords">
                <field name="name" string="Keyword"/>
                <field name="site_id"/>
                <field name="best_page" string="Ranking page"/>
                <filter name="on_page_one" string="On page 1"
                        domain="[('position', '&lt;=', 10),
                                 ('position', '&gt;', 0)]"/>
                <filter name="almost_there" string="Positions 4-20"
                        domain="[('position', '&gt;=', 4),
                                 ('position', '&lt;=', 20)]"
                        help="The quickest wins: one push reaches page 1."/>
                <filter name="with_clicks" string="Bringing clicks"
                        domain="[('clicks', '&gt;', 0)]"/>
                <separator/>
                <filter name="manual" string="My targets"
                        domain="[('origin', '=', 'manual')]"/>
                <filter name="discovered" string="Found in Search Console"
                        domain="[('origin', '=', 'discovered')]"
                        help="Queries Google already shows you for without you declaring them — the demand you did not plan for."/>
                <!-- Odoo 19's search <group> takes neither string nor
                     expand and holds fields only; group-by filters live
                     at search level and the web client files them under
                     "Group By" on its own. -->
                <separator/>
                <filter name="group_site" string="Site"
                        context="{'group_by': 'site_id'}"/>
                <filter name="group_origin" string="Origin"
                        context="{'group_by': 'origin'}"/>
                <filter name="group_page" string="Ranking page"
                        context="{'group_by': 'best_page'}"/>
            </search>
        </field>
    </record>

    <record id="action_seo_keyword" model="ir.actions.act_window">
        <field name="name">Keywords</field>
        <field name="res_model">seo.keyword</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_seo_keyword_search"/>
        <field name="context">{'search_default_group_origin': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track your target keywords</p>
            <p>Add the queries you want to rank on. Every Google sync stores
               the Search Console position, building a trend per keyword —
               and DataForSEO (optional, paid) adds volumes and live SERPs.</p>
            <p>Syncing Google also brings in the queries you already rank
               for without having declared them.</p>
        </field>
    </record>

    <menuitem id="menu_seo_keyword" name="Keywords"
              parent="menu_seo_root" action="action_seo_keyword"
              sequence="8"/>

</odoo>
